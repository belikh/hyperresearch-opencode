    {
      "id": "lock-5",
      "title": "Stability Modelling of mRNA Vaccine Quality Based on Temperature Monitoring throughout the Distribution Chain (Kis 2022)",
      "path": "research/notes/lock-5.md",
      "status": "draft",
      "type": "note",
      "tier": "ground_truth",
